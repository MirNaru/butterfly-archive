# Optional backend SQLite path, relative to the project root.
BUTTERFLY_DB_PATH=data/butterfly.sqlite3

# Maps is disabled until the representative account and provider hard limits are confirmed.
NAVER_MAPS_CLIENT_ID=
NAVER_MAPS_CLIENT_SECRET=
MAPS_ENABLED=false
MAPS_FREE_TIER_CONFIRMED=false

# Optional provider console snapshot, shown separately from local counts.
NAVER_USAGE_SNAPSHOT_DATE=
NAVER_MAP_USAGE_SNAPSHOT=
NAVER_GEOCODE_USAGE_SNAPSHOT=
NAVER_REVERSE_USAGE_SNAPSHOT=

# Secrets stay in the backend. Do not use VITE_ prefixes for secret values.
KMA_API_PROVIDER=apihub
KMA_API_KEY=
KMA_ENABLED=false

# KCI Open API key for literature search. Keep the real key only in .env.
KCI_API_KEY=

# Google AI Studio에서 결제 미연결 무료 프로젝트임을 확인한 뒤 1로 설정합니다.
GEMINI_API_KEY=
BUTTERFLY_GEMINI_FREE_PROJECT=0
