{
  "manifest_version": 3,
  "name": "나비 아카이브 · 네이처링",
  "version": "0.4.7",
  "description": "공개 관찰 기록을 읽고 다음 관찰을 연속으로 로컬 DB로 전송합니다.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "관찰 기록 가져오기"
  },
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://www.naturing.net/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
